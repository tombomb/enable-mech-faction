<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MechFactionEnabler</RootNamespace>
    <AssemblyName>MechFactionEnabler</AssemblyName>
    <Version>1.0.0</Version>

    <!-- RimWorld loads the DLL from <mod>/1.6/Assemblies. Build straight there. -->
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference assemblies for RimWorld 1.6 (Assembly-CSharp, UnityEngine.*).
      ExcludeAssets=runtime keeps the game DLLs out of our output folder — the
      game already has them. This means no game install is needed to build,
      which is what lets GitHub Actions build the mod.
      Keep this version in sync with the game build (Version.txt in the game folder).
    -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" />

    <!-- Lets `dotnet build` target net472 on machines/CI without the targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
